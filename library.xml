<!-- Archiv: Seitenleiste mit Suche links, Titelliste rechts -->
<Template>
  <WidgetGroup>
    <ObjectName>LibraryPanel</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <Layout>horizontal</Layout>
    <Children>
      <Splitter>
        <SizePolicy>me,me</SizePolicy>
        <!-- Startbreiten in Pixeln; Seitenleiste kann nicht zuklappen.
             Eigener Schlüssel, damit andere Skins die Breite nicht überschreiben. -->
        <SplitSizes>260,1000</SplitSizes>
        <Collapsible>0,0</Collapsible>
        <SplitSizesConfigKey>[Skin],twindeck_sidebar_splitsize</SplitSizesConfigKey>
        <Children>
          <WidgetGroup>
            <SizePolicy>min,me</SizePolicy>
            <MinimumSize>180,100</MinimumSize>
            <Layout>vertical</Layout>
            <Children>
              <Label>
                <ObjectName>PanelCaption</ObjectName>
                <Size>0me,22f</Size>
                <Text>ARCHIV</Text>
              </Label>
              <SearchBox></SearchBox>
              <WidgetGroup><Size>1f,4f</Size></WidgetGroup>
              <LibrarySidebar></LibrarySidebar>
            </Children>
          </WidgetGroup>
          <Library>
            <ShowButtonText>true</ShowButtonText>
            <TrackTableBackgroundColorOpacity>0.2</TrackTableBackgroundColorOpacity>
          </Library>
        </Children>
      </Splitter>
    </Children>
  </WidgetGroup>
</Template>
