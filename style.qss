/*
  TwinDeck Classic – Farbschema
  Gehäuse: dunkles Blaugrau, Anzeigen: LCD-Cyan, Akzent: Orange
*/

/* ---------- Grundlagen ---------- */
#Mixxx, WWidget, WLabel, WPushButton, WNumber, WNumberPos, WTrackProperty,
WTime, QToolTip, WSearchLineEdit, WTrackTableView, WLibrarySidebar,
WTrackTableViewHeader::section {
  font-family: "Helvetica Neue", "Segoe UI", "Arial", sans-serif;
}

#Mixxx {
  background-color: #1b2129;
}

QToolTip {
  background-color: #0b1016;
  color: #d8e2ec;
  border: 1px solid #3a4552;
  padding: 3px;
}

/* ---------- Panels ---------- */
#DeckPanel, #PitchPanel, #MixerPanel {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2f3a46, stop:1 #222a33);
  border: 1px solid #0b0f14;
  border-radius: 4px;
  margin: 3px;
  padding: 4px;
}

#PanelCaption, #DeckLetter {
  color: #e08a12;
  font-size: 12px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#DeckLetter {
  qproperty-alignment: 'AlignLeft | AlignVCenter';
  padding-left: 2px;
}

#DeckArtist {
  color: #d8e2ec;
  font-size: 16px;
  font-weight: bold;
  padding-left: 6px;
}

#RowCaption, #FaderLabel, #KnobLabel {
  color: #8592a0;
  font-size: 10px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#RateRange {
  color: #8592a0;
  font-size: 10px;
  qproperty-alignment: 'AlignCenter';
}

#Clock {
  color: #5fd7ff;
  font-size: 12px;
  font-weight: bold;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 4px;
}

/* ---------- LCD-Anzeige ---------- */
#Lcd {
  background-color: #0a1c2c; /* einfarbig, passend zum Hintergrund der Schallplatte */
  border: 2px solid #0b0f14;
  border-radius: 3px;
  margin-top: 2px;
  margin-bottom: 3px;
}

#LcdTitle {
  color: #9fe6ff;
  font-size: 20px;
  font-weight: bold;
  padding: 3px 6px 0px 6px;
}

#LcdTime {
  color: #5fd7ff;
  font-size: 32px;
  font-weight: bold;
  padding-left: 6px;
}

#LcdCaption {
  color: #3f86a8;
  font-size: 9px;
  font-weight: bold;
}

#LcdBpm, #LcdRate, #LcdKey {
  color: #5fd7ff;
  font-size: 13px;
  font-weight: bold;
  padding-right: 6px;
}

/* Titelende naht: LCD wird rot */
#Lcd[highlight="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a1210, stop:1 #2a0806);
  border: 2px solid #ff3b30;
}

#LcdCover {
  border: 1px solid #0b0f14;
  background-color: #05080c;
}

#LcdDetail, #LcdDetailGenre, #LcdDetailYear {
  color: #3f9cc4;
  font-size: 13px;
  padding-left: 6px;
}
#LcdDetailYear {
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 6px;
}

/* Beat-LED */
#BeatLed {
  background-color: #1c2630;
  border: 1px solid #0b0f14;
  border-radius: 6px;
}
#BeatLed[highlight="1"] {
  background-color: #ff3b30;
  border: 1px solid #ffc4bf;
}

#OverviewFrame, #WaveformFrame {
  border: 1px solid #0b0f14;
  margin-bottom: 3px;
}

/* ---------- Tasten ----------
   Aus:  dunkel, gedämpfte Schrift
   An:   kräftige Füllfarbe, heller Rahmen und eine Leuchtleiste unten
*/
WPushButton {
  color: #9aa6b2;
  font-size: 12px;
  font-weight: bold;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a4552, stop:1 #29313b);
  border: 1px solid #0b0f14;
  border-bottom: 3px solid #1c232c;
  border-radius: 3px;
  margin: 2px;
}

WPushButton[hover="true"] {
  color: #d8e2ec;
}

WPushButton[pressed="true"] {
  background-color: #1f262e;
}

/* aktiv = Orange */
WPushButton[displayValue="1"] {
  color: #1b1200;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffc56b, stop:1 #e08a12);
  border: 1px solid #ffe2b0;
  border-bottom: 3px solid #ffffff;
}

/* Play = Grün */
#PlayButton {
  font-size: 15px;
}
#PlayButton[displayValue="1"] {
  color: #04140a;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8af5a4, stop:1 #2fb455);
  border: 1px solid #c8ffd6;
  border-bottom: 3px solid #ffffff;
}

/* Cue = Rot, wenn aktiv */
#CueButton[displayValue="1"] {
  color: #ffffff;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff7b72, stop:1 #d4281e);
  border: 1px solid #ffc4bf;
  border-bottom: 3px solid #ffffff;
}

/* Sync / Vorhören = Blau */
#SyncButton[displayValue="1"], #PflButton[displayValue="1"] {
  color: #001521;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #b8eeff, stop:1 #3aa9d6);
  border: 1px solid #e0f7ff;
  border-bottom: 3px solid #ffffff;
}

/* Cue-Speicher: belegt = Orange, gerade aktiv = hell */
#HotcueButton {
  font-size: 11px;
}
#HotcueButton[displayValue="2"] {
  color: #1b1200;
  background-color: #ffe2b0;
  border: 1px solid #ffffff;
  border-bottom: 3px solid #ffffff;
}

#LoopButton {
  font-size: 11px;
}
#LoopButton[displayValue="1"] {
  color: #04140a;
  background-color: #34d058;
  border: 1px solid #c8ffd6;
  border-bottom: 3px solid #ffffff;
}

/* reine Taster (kein Zustand) */
#StopButton, #PitchButton, #MixerButton, #DeckButton, #EjectButton {
  color: #d8e2ec;
}

#PitchButton {
  font-size: 13px;
  margin: 1px;
}

#EjectButton {
  font-size: 12px;
  margin: 0px;
  border-bottom: 1px solid #0b0f14;
}

/* Automix */
#AutomixBox {
  border-top: 1px solid #3a4552;
  padding-top: 2px;
}
#AutomixButton {
  font-size: 11px;
}
#AutomixButton[displayValue="1"] {
  color: #04140a;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8af5a4, stop:1 #2fb455);
  border: 1px solid #c8ffd6;
  border-bottom: 3px solid #ffffff;
}

/* Aufnahme: 1 = bereit, 2 = läuft */
#RecButton[displayValue="1"] {
  color: #1b1200;
  background-color: #ffcc00;
  border-bottom: 3px solid #ffffff;
}
#RecButton[displayValue="2"] {
  color: #ffffff;
  background-color: #d4281e;
  border: 1px solid #ffc4bf;
  border-bottom: 3px solid #ffffff;
}

/* ---------- Archiv / Bibliothek ---------- */
#LibraryPanel {
  background-color: #1b2129;
  margin: 0px 3px 3px 3px;
}

WSearchLineEdit {
  color: #d8e2ec;
  background-color: #0b1016;
  border: 1px solid #3a4552;
  border-radius: 3px;
  padding: 3px;
  selection-color: #1b1200;
  selection-background-color: #e08a12;
}
WSearchLineEdit:focus {
  border: 1px solid #e08a12;
}
WSearchLineEdit QAbstractItemView {
  color: #d8e2ec;
  background-color: #0b1016;
  selection-color: #1b1200;
  selection-background-color: #e08a12;
}

WTrackTableView, WLibrarySidebar, WLibraryTextBrowser {
  color: #c4ced8;
  background-color: #10151b;
  alternate-background-color: #161d25;
  border: 1px solid #0b0f14;
  selection-color: #ffffff;
  selection-background-color: #3a6d8c;
  outline: none;
  font-size: 13px;
}

WTrackTableView {
  qproperty-focusBorderColor: #e08a12;
  qproperty-trackPlayedColor: #5d6773;
}

WTrackTableView::item:selected,
WLibrarySidebar::item:selected,
WLibrarySidebar::branch:selected {
  background-color: #3a6d8c;
  color: #ffffff;
}

WTrackTableView::item:!selected:focus {
  background-color: #161d25;
  outline: 1px solid #e08a12;
}

WLibrarySidebar::item {
  padding: 2px;
}

WTrackTableViewHeader {
  background-color: #222a33;
}
WTrackTableViewHeader::section {
  color: #e08a12;
  font-size: 12px;
  font-weight: bold;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333d48, stop:1 #222a33);
  border: none;
  border-right: 1px solid #10151b;
  padding: 3px 4px;
}

/* Bedienelemente oberhalb der Titelliste (z. B. Automix-Seite) */
#LibraryFeatureControls QLabel,
#LibraryFeatureControls QRadioButton {
  color: #c4ced8;
}
#LibraryFeatureControls QPushButton,
QPushButton#pushButtonAutoDJ,
QPushButton#pushButtonFadeNow,
QPushButton#pushButtonSkipNext,
QPushButton#pushButtonShuffle,
QPushButton#pushButtonAddRandomTrack,
QPushButton#pushButtonRepeatPlaylist {
  color: #d8e2ec;
  background-color: #333d48;
  border: 1px solid #0b0f14;
  border-radius: 3px;
  padding: 3px 8px;
}
#LibraryFeatureControls QPushButton:checked,
QPushButton#pushButtonAutoDJ:checked {
  color: #04140a;
  background-color: #2fb455;
}
#LibraryFeatureControls QPushButton:!enabled {
  color: #5d6773;
}

/* Kontextmenüs */
WTrackMenu, WTrackMenu QMenu, WLibrarySidebar QMenu,
WTrackTableViewHeader QMenu, QLineEdit QMenu {
  color: #d8e2ec;
  background-color: #222a33;
  border: 1px solid #0b0f14;
}
WTrackMenu::item:selected, WTrackMenu QMenu::item:selected,
WLibrarySidebar QMenu::item:selected, QLineEdit QMenu::item:selected {
  color: #1b1200;
  background-color: #e08a12;
}

/* Rollbalken */
QScrollBar:vertical {
  background: #10151b;
  width: 12px;
  border: none;
}
QScrollBar:horizontal {
  background: #10151b;
  height: 12px;
  border: none;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #3a4552;
  border-radius: 4px;
  margin: 2px;
  min-height: 24px;
  min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  border: none;
  background: none;
  width: 0px;
  height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
  background: none;
}

QSplitter::handle {
  background-color: #1b2129;
  width: 4px;
}

/* ---------- Überblend-Vorwahl ---------- */
#XfadePreset {
  background: none;
  border: none;
  margin: 1px;
}
#XfadePresetBox {
  border-top: 1px solid #3a4552;
}

/* ---------- Auto-DJ-Ansicht im Archiv (Modus + Dauer) ---------- */
QComboBox#fadeModeCombobox, QSpinBox#spinBoxTransition {
  color: #5fd7ff;
  background-color: #0b1016;
  border: 1px solid #3a4552;
  border-radius: 3px;
  padding: 2px 6px;
  font-weight: bold;
  selection-color: #1b1200;
  selection-background-color: #e08a12;
}
QComboBox#fadeModeCombobox QAbstractItemView {
  color: #d8e2ec;
  background-color: #222a33;
  selection-color: #1b1200;
  selection-background-color: #e08a12;
}
#labelTransitionAppendix {
  color: #c4ced8;
}

/* gesperrte Tasten (z. B. FADE/SKIP bei ausgeschaltetem Automix) */
WPushButton:disabled {
  color: #4a5562;
  background-color: #232a32;
  border: 1px solid #1a2028;
  border-bottom: 3px solid #1a2028;
}

/* Trennlinie im LCD über der BPM/PITCH/KEY-Zeile */
#LcdDivider {
  background-color: #1f4a63;
  margin-left: 6px;
  margin-right: 6px;
}
