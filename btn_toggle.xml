<!--
  Zwei-Zustands-Taste (an/aus), Text wird per QSS gestaltet.
  Variablen: ObjectName, Size, Text, ConfigKey, Tooltip
-->
<Template>
  <PushButton>
    <ObjectName><Variable name="ObjectName"/></ObjectName>
    <Tooltip><Variable name="Tooltip"/></Tooltip>
    <Size><Variable name="Size"/></Size>
    <NumberStates>2</NumberStates>
    <State><Number>0</Number><Text><Variable name="Text"/></Text></State>
    <State><Number>1</Number><Text><Variable name="Text"/></Text></State>
    <Connection>
      <ConfigKey><Variable name="ConfigKey"/></ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>
