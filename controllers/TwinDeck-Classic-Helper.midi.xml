<?xml version="1.0" encoding="utf-8"?>
<!--
  TwinDeck Classic Helper
  Kein echter Controller: Dieses Mapping wird auf ein virtuelles MIDI-Gerät
  (macOS: IAC-Treiber, Windows: loopMIDI, Linux: Midi Through) gelegt, damit
  Mixxx das Skript ausführt. Das Skript ergänzt den Skin TwinDeck Classic um
  Plattenbremse, sanften Anlauf und eine Überblendung mit einstellbarer Dauer.
-->
<MixxxControllerPreset mixxxVersion="2.5.0+" schemaVersion="1">
  <info>
    <name>TwinDeck Classic Helper</name>
    <author>TwinDeck Classic</author>
    <description>Ergänzt den Skin TwinDeck Classic: Plattenbremse bei Stopp/Pause, sanfter Anlauf bei Play und FADE mit einstellbarer Dauer. Auf ein virtuelles MIDI-Gerät legen (IAC-Treiber, loopMIDI, Midi Through).</description>
  </info>
  <controller id="TwinDeckHelper">
    <scriptfiles>
      <file filename="TwinDeck-Classic-Helper.js" functionprefix="TwinDeckHelper"/>
    </scriptfiles>
    <controls/>
    <outputs/>
  </controller>
</MixxxControllerPreset>
