<!--
  Player (ohne Pitch-Spalte, die liegt außen in pitch.xml).
  Variablen: channum (1/2), letter (A/B)
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="channum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>DeckPanel</ObjectName>
    <SizePolicy>me,me</SizePolicy>
    <Layout>vertical</Layout>
    <Children>

      <!-- Kopfzeile: PLAYER A / Titel -->
      <WidgetGroup>
        <ObjectName>DeckHeader</ObjectName>
        <Size>0me,28f</Size>
        <Layout>horizontal</Layout>
        <Children>
          <Label>
            <ObjectName>DeckLetter</ObjectName>
            <Size>78f,28f</Size>
            <Text>PLAYER <Variable name="letter"/></Text>
          </Label>
          <TrackProperty>
            <ObjectName>DeckArtist</ObjectName>
            <MinimumSize>30,0</MinimumSize>
            <Style>QLabel { font-size: 17px; font-weight: bold; color: #d8e2ec; padding-left: 6px; }</Style>
            <TooltipId>track_artist</TooltipId>
            <Channel><Variable name="channum"/></Channel>
            <Property>artist</Property>
            <SizePolicy>me,f</SizePolicy>
            <Elide>right</Elide>
          </TrackProperty>
          <!-- Beat-LED: blinkt im Takt -->
          <WidgetGroup>
            <Size>22f,28f</Size>
            <Layout>vertical</Layout>
            <Children>
              <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
              <WidgetGroup>
                <ObjectName>BeatLed</ObjectName>
                <Tooltip>Beat-Anzeige – blinkt im Takt des Titels</Tooltip>
                <Size>12f,12f</Size>
                <Connection>
                  <ConfigKey><Variable name="group"/>,beat_active</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
            </Children>
          </WidgetGroup>
          <PushButton>
            <ObjectName>EjectButton</ObjectName>
            <TooltipId>eject</TooltipId>
            <Size>26f,18f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>⏏</Text></State>
            <Connection>
              <ConfigKey><Variable name="group"/>,eject</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!-- LCD-Anzeige: oben Cover | Titel/Details/Zeit | Schallplatte,
           unten BPM / PITCH / KEY nebeneinander über die volle Breite -->
      <WidgetGroup>
        <ObjectName>Lcd</ObjectName>
        <SizePolicy>me,me</SizePolicy>
        <MinimumSize>200,170</MinimumSize>
        <Layout>vertical</Layout>
        <!-- Titelende naht: LCD färbt sich rot -->
        <Connection>
          <ConfigKey><Variable name="group"/>,end_of_track</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
        <Children>
          <!-- Titel und Interpret: bei schmalem LCD zweizeilig (Titel, darunter
               Interpret), ab 560 Punkten Breite einzeilig: Titel links, Interpret rechts.
               Mixxx wählt die passende Variante selbst (SizeAwareStack). -->
          <SizeAwareStack>
            <SizePolicy>me,f</SizePolicy>
            <Size>0me,78f</Size>
            <Children>
              <WidgetGroup>
                <MinimumSize>100,78</MinimumSize>
                <MaximumSize>559,78</MaximumSize>
                <Layout>vertical</Layout>
                <Children>
                  <TrackProperty>
                    <ObjectName>LcdTitle</ObjectName>
                    <MinimumSize>30,0</MinimumSize>
                    <Style>QLabel { font-size: 22px; font-weight: bold; color: #9fe6ff; padding: 4px 8px 0px 5px; }</Style>
                    <TooltipId>track_title</TooltipId>
                    <Channel><Variable name="channum"/></Channel>
                    <Property>title</Property>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,30f</Size>
                    <Elide>right</Elide>
                  </TrackProperty>
                  <TrackProperty>
                    <ObjectName>LcdArtist</ObjectName>
                    <MinimumSize>30,0</MinimumSize>
                    <Style>QLabel { font-size: 18px; font-weight: bold; color: #7cc8e8; padding: 0px 8px 2px 7px; }</Style>
                    <TooltipId>track_artist</TooltipId>
                    <Channel><Variable name="channum"/></Channel>
                    <Property>artist</Property>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,26f</Size>
                    <Elide>right</Elide>
                  </TrackProperty>
                  <WidgetGroup>
                    <ObjectName>LcdDetails</ObjectName>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,22f</Size>
                    <Layout>horizontal</Layout>
                    <Children>
                      <TrackProperty>
                        <ObjectName>LcdDetail</ObjectName>
                        <MinimumSize>30,0</MinimumSize>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-left: 8px; }</Style>
                        <Tooltip>Album</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>album</Property>
                        <SizePolicy>me,f</SizePolicy>
                        <Elide>right</Elide>
                      </TrackProperty>
                      <TrackProperty>
                        <ObjectName>LcdDetailGenre</ObjectName>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-left: 6px; }</Style>
                        <Tooltip>Genre</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>genre</Property>
                        <Size>120f,22f</Size>
                        <Elide>right</Elide>
                      </TrackProperty>
                      <TrackProperty>
                        <ObjectName>LcdDetailYear</ObjectName>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-right: 8px; qproperty-alignment: 'AlignRight | AlignVCenter'; }</Style>
                        <Tooltip>Jahr</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>year</Property>
                        <Size>52f,22f</Size>
                      </TrackProperty>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <MinimumSize>560,78</MinimumSize>
                <Layout>vertical</Layout>
                <Children>
                  <WidgetGroup>
                    <ObjectName>LcdTitleRow</ObjectName>
                    <Size>0me,34f</Size>
                    <Layout>horizontal</Layout>
                    <Children>
                      <!-- Titel links, Interpret rechtsbündig; beide teilen sich die Breite fest,
                           unabhängig von der Textlänge (sonst kann Mixxx den Titel wegkürzen). -->
                      <TrackProperty>
                        <ObjectName>LcdTitle</ObjectName>
                        <MinimumSize>30,0</MinimumSize>
                        <Style>QLabel { font-size: 22px; font-weight: bold; color: #9fe6ff; padding: 4px 6px 2px 5px; }</Style>
                        <TooltipId>track_title</TooltipId>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>title</Property>
                        <SizePolicy>me,f</SizePolicy>
                        <Elide>right</Elide>
                      </TrackProperty>
                      <TrackProperty>
                        <ObjectName>LcdArtist</ObjectName>
                        <MinimumSize>30,0</MinimumSize>
                        <Style>QLabel { font-size: 18px; font-weight: bold; color: #7cc8e8; padding: 4px 8px 2px 6px; qproperty-alignment: 'AlignRight | AlignVCenter'; }</Style>
                        <TooltipId>track_artist</TooltipId>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>artist</Property>
                        <SizePolicy>me,f</SizePolicy>
                        <Elide>right</Elide>
                      </TrackProperty>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>LcdDetails</ObjectName>
                    <SizePolicy>me,f</SizePolicy>
                    <Size>0me,22f</Size>
                    <Layout>horizontal</Layout>
                    <Children>
                      <TrackProperty>
                        <ObjectName>LcdDetail</ObjectName>
                        <MinimumSize>30,0</MinimumSize>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-left: 8px; }</Style>
                        <Tooltip>Album</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>album</Property>
                        <SizePolicy>me,f</SizePolicy>
                        <Elide>right</Elide>
                      </TrackProperty>
                      <TrackProperty>
                        <ObjectName>LcdDetailGenre</ObjectName>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-left: 6px; }</Style>
                        <Tooltip>Genre</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>genre</Property>
                        <Size>120f,22f</Size>
                        <Elide>right</Elide>
                      </TrackProperty>
                      <TrackProperty>
                        <ObjectName>LcdDetailYear</ObjectName>
                        <Style>QLabel { font-size: 14px; color: #3f9cc4; padding-right: 8px; qproperty-alignment: 'AlignRight | AlignVCenter'; }</Style>
                        <Tooltip>Jahr</Tooltip>
                        <Channel><Variable name="channum"/></Channel>
                        <Property>year</Property>
                        <Size>52f,22f</Size>
                      </TrackProperty>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><SizePolicy>me,me</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </SizeAwareStack>
          <WidgetGroup>
            <SizePolicy>me,me</SizePolicy>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup>
                <ObjectName>LcdCoverBox</ObjectName>
                <Size>112f,0me</Size>
                <Layout>vertical</Layout>
                <Children>
                  <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
                  <CoverArt>
                    <ObjectName>LcdCover</ObjectName>
                    <TooltipId>coverart</TooltipId>
                    <Group><Variable name="group"/></Group>
                    <Size>104f,104f</Size>
                  </CoverArt>
                  <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <SizePolicy>me,me</SizePolicy>
                <Layout>vertical</Layout>
                <Children>
                  <!-- Zeitanzeige: Mixxx liefert "abgelaufen  -Rest" als einen Text.
                       Der SizeAwareStack zeigt je nach verfügbarer Breite die passende
                       Variante: schmal = untereinander, breit = nebeneinander. -->
                  <SizeAwareStack>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <WidgetGroup>
                        <MinimumSize>150,0</MinimumSize>
                        <MaximumSize>359,10000</MaximumSize>
                        <Layout>vertical</Layout>
                        <Children>
                          <NumberPos>
                            <ObjectName>LcdTime</ObjectName>
                            <Style>QLabel { font-size: 32px; font-weight: bold; color: #5fd7ff; padding-left: 10px; qproperty-wordWrap: true; }</Style>
                            <TooltipId>track_time</TooltipId>
                            <Group><Variable name="group"/></Group>
                            <SizePolicy>me,me</SizePolicy>
                            <Alignment>left</Alignment>
                            <MaximumSize>230,10000</MaximumSize>
                          </NumberPos>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <MinimumSize>360,0</MinimumSize>
                        <Layout>vertical</Layout>
                        <Children>
                          <NumberPos>
                            <ObjectName>LcdTime</ObjectName>
                            <Style>QLabel { font-size: 32px; font-weight: bold; color: #5fd7ff; padding-left: 10px; }</Style>
                            <TooltipId>track_time</TooltipId>
                            <Group><Variable name="group"/></Group>
                            <SizePolicy>me,me</SizePolicy>
                            <Alignment>left</Alignment>
                          </NumberPos>
                        </Children>
                      </WidgetGroup>
                    </Children>
                  </SizeAwareStack>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SpinnyBox</ObjectName>
                <Size>140f,0me</Size>
                <Layout>vertical</Layout>
                <Children>
                  <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
                  <Spinny>
                    <TooltipId>spinny</TooltipId>
                    <Size>132f,132f</Size>
                    <Group><Variable name="group"/></Group>
                    <PathBackground scalemode="STRETCH_ASPECT">skin:graphics/spinny_bg.svg</PathBackground>
                    <PathMask scalemode="STRETCH_ASPECT">skin:graphics/spinny_mask.svg</PathMask>
                    <PathForeground>skin:graphics/spinny_indicator.svg</PathForeground>
                    <PathGhost>skin:graphics/spinny_ghost.svg</PathGhost>
                    <ShowCoverControl>[Skin],twindeck_spinny_cover</ShowCoverControl>
                  </Spinny>
                  <WidgetGroup><SizePolicy>f,me</SizePolicy></WidgetGroup>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_show_spinny</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>LcdDivider</ObjectName>
            <Size>0me,1f</Size>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>LcdInfoRow</ObjectName>
            <Size>0me,28f</Size>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup>
                <ObjectName>LcdInfoCell</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                  <Label>
                    <ObjectName>LcdCaption</ObjectName>
                    <Style>QLabel { font-size: 11px; font-weight: bold; color: #3f86a8; padding-right: 6px; }</Style>
                    <SizePolicy>min,me</SizePolicy>
                    <Text>BPM</Text>
                  </Label>
                  <NumberBpm>
                    <ObjectName>LcdBpm</ObjectName>
                    <Style>QLabel { font-size: 17px; font-weight: bold; color: #5fd7ff; }</Style>
                    <TooltipId>visual_bpm</TooltipId>
                    <Channel><Variable name="channum"/></Channel>
                    <SizePolicy>min,me</SizePolicy>
                    <Alignment>left</Alignment>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,visual_bpm</ConfigKey>
                    </Connection>
                  </NumberBpm>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>LcdInfoCell</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                  <Label>
                    <ObjectName>LcdCaption</ObjectName>
                    <Style>QLabel { font-size: 11px; font-weight: bold; color: #3f86a8; padding-right: 6px; }</Style>
                    <SizePolicy>min,me</SizePolicy>
                    <Text>PITCH</Text>
                  </Label>
                  <NumberRate>
                    <ObjectName>LcdRate</ObjectName>
                    <Style>QLabel { font-size: 17px; font-weight: bold; color: #5fd7ff; }</Style>
                    <TooltipId>rate_display</TooltipId>
                    <Channel><Variable name="channum"/></Channel>
                    <SizePolicy>min,me</SizePolicy>
                    <Alignment>left</Alignment>
                    <NumberOfDigits>1</NumberOfDigits>
                  </NumberRate>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>LcdInfoCell</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                  <Label>
                    <ObjectName>LcdCaption</ObjectName>
                    <Style>QLabel { font-size: 11px; font-weight: bold; color: #3f86a8; padding-right: 6px; }</Style>
                    <SizePolicy>min,me</SizePolicy>
                    <Text>KEY</Text>
                  </Label>
                  <Key>
                    <ObjectName>LcdKey</ObjectName>
                    <Style>QLabel { font-size: 17px; font-weight: bold; color: #5fd7ff; }</Style>
                    <TooltipId>visual_key</TooltipId>
                    <Channel><Variable name="channum"/></Channel>
                    <SizePolicy>min,me</SizePolicy>
                    <Alignment>left</Alignment>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,visual_key</ConfigKey>
                    </Connection>
                  </Key>
                  <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <!-- Übersicht des ganzen Titels (zum Springen anklicken) -->
      <WidgetGroup>
        <ObjectName>OverviewFrame</ObjectName>
        <Size>0me,40f</Size>
        <Layout>horizontal</Layout>
        <Children>
          <Overview>
            <TooltipId>waveform_overview</TooltipId>
            <Channel><Variable name="channum"/></Channel>
            <SizePolicy>me,me</SizePolicy>
            <BgColor>#05080c</BgColor>
            <SignalColor>#5fd7ff</SignalColor>
            <PlayPosColor>#ffffff</PlayPosColor>
            <EndOfTrackColor>#ff3b30</EndOfTrackColor>
            <PlayedOverlayColor>#90000000</PlayedOverlayColor>
            <PassthroughLabelColor>#ffcc00</PassthroughLabelColor>
            <DefaultMark>
              <Align>bottom|right</Align>
              <Color>#e08a12</Color>
              <TextColor>#000000</TextColor>
              <Text> %1 </Text>
            </DefaultMark>
            <Mark>
              <Control>cue_point</Control>
              <Text>C</Text>
              <Align>top|right</Align>
              <Color>#ff3b30</Color>
              <TextColor>#ffffff</TextColor>
            </Mark>
            <MarkRange>
              <StartControl>loop_start_position</StartControl>
              <EndControl>loop_end_position</EndControl>
              <EnabledControl>loop_enabled</EnabledControl>
              <Color>#34d058</Color>
              <Opacity>0.6</Opacity>
              <DisabledColor>#ffffff</DisabledColor>
              <DisabledOpacity>0.3</DisabledOpacity>
            </MarkRange>
            <Connection>
              <ConfigKey><Variable name="group"/>,playposition</ConfigKey>
              <EmitOnDownPress>false</EmitOnDownPress>
            </Connection>
          </Overview>
        </Children>
      </WidgetGroup>

      <!-- Laufende Wellenform (flach) -->
      <WidgetGroup>
        <SizePolicy>me,f</SizePolicy>
        <Size>0me,64f</Size>
        <Layout>horizontal</Layout>
        <Children>
      <!-- Laufende Wellenform (über Ansicht-Menü ausblendbar) -->
      <WidgetGroup>
        <ObjectName>WaveformFrame</ObjectName>
        <SizePolicy>me,f</SizePolicy>
        <Size>0me,64f</Size>
        <Layout>horizontal</Layout>
        <Children>
          <Visual>
            <TooltipId>waveform_display</TooltipId>
            <Channel><Variable name="channum"/></Channel>
            <SizePolicy>me,me</SizePolicy>
            <BgColor>#05080c</BgColor>
            <SignalColor>#5fd7ff</SignalColor>
            <BeatColor>#3a4552</BeatColor>
            <PlayPosColor>#ffffff</PlayPosColor>
            <EndOfTrackColor>#ff3b30</EndOfTrackColor>
            <AxesColor>#1c2630</AxesColor>
            <PassthroughLabelColor>#ffcc00</PassthroughLabelColor>
            <DefaultMark>
              <Align>top</Align>
              <Color>#e08a12</Color>
              <TextColor>#000000</TextColor>
              <Text> %1 </Text>
            </DefaultMark>
            <Mark>
              <Control>cue_point</Control>
              <Text>CUE</Text>
              <Align>top</Align>
              <Color>#ff3b30</Color>
              <TextColor>#ffffff</TextColor>
            </Mark>
            <MarkRange>
              <StartControl>loop_start_position</StartControl>
              <EndControl>loop_end_position</EndControl>
              <EnabledControl>loop_enabled</EnabledControl>
              <Color>#34d058</Color>
              <Opacity>0.5</Opacity>
              <DisabledColor>#ffffff</DisabledColor>
              <DisabledOpacity>0.2</DisabledOpacity>
            </MarkRange>
          </Visual>
        </Children>
        <Connection>
          <ConfigKey>[Skin],show_waveforms</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>
        </Children>
      </WidgetGroup>

      <!-- Laufwerkstasten -->
      <WidgetGroup>
        <ObjectName>TransportRow</ObjectName>
        <Size>0me,38f</Size>
        <Layout>horizontal</Layout>
        <Children>
          <PushButton>
            <ObjectName>CueButton</ObjectName>
            <TooltipId>cue_default_cue_gotoandstop</TooltipId>
            <Size>46f,32f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>CUE</Text></State>
            <State><Number>1</Number><Text>CUE</Text></State>
            <Connection>
              <ConfigKey><Variable name="group"/>,cue_default</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="group"/>,cue_gotoandstop</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>RightButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="group"/>,cue_indicator</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>

          <!-- Play: ohne Helfer direkt, mit Helfer mit sanftem Anlauf / Plattenbremse -->
          <WidgetGroup>
            <Size>60f,32f</Size>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup>
                <Size>60f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>PlayButton</ObjectName>
                    <TooltipId>play_cue_set</TooltipId>
                    <Size>60f,32f</Size>
                    <NumberStates>2</NumberStates>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_play_off.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_play_off.svg</Pressed></State>
                    <State><Number>1</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_play_on.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_play_on.svg</Pressed></State>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,play</ConfigKey>
                      <ButtonState>LeftButton</ButtonState>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,cue_set</ConfigKey>
                      <ButtonState>RightButton</ButtonState>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,play_indicator</ConfigKey>
                      <ConnectValueFromWidget>false</ConnectValueFromWidget>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <Size>60f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>PlayButton</ObjectName>
                    <Tooltip>Play/Pause – läuft wie ein Plattenspieler langsam an bzw. bremst ab. Rechtsklick: Cue-Punkt setzen</Tooltip>
                    <Size>60f,32f</Size>
                    <NumberStates>2</NumberStates>
                    <!-- Taster statt Umschalter: jeder Klick sendet 1 (drücken) und 0 (loslassen),
                         sonst würde nur jeder zweite Klick beim Helfer ankommen -->
                    <LeftClickIsPushButton>true</LeftClickIsPushButton>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_play_off.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_play_off.svg</Pressed></State>
                    <State><Number>1</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_play_on.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_play_on.svg</Pressed></State>
                    <Connection>
                      <ConfigKey>[Skin],twindeck_play_<Variable name="channum"/></ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>LeftButton</ButtonState>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,cue_set</ConfigKey>
                      <ButtonState>RightButton</ButtonState>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ConnectValueToWidget>false</ConnectValueToWidget>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,play_indicator</ConfigKey>
                      <ConnectValueFromWidget>false</ConnectValueFromWidget>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- Stopp: ohne Helfer sofort zum Anfang, mit Helfer Plattenbremse -->
          <WidgetGroup>
            <Size>40f,32f</Size>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup>
                <Size>40f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>StopButton</ObjectName>
                    <Tooltip>Stopp – hält an und springt zum Anfang</Tooltip>
                    <Size>40f,32f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_stop.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_stop.svg</Pressed></State>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,start_stop</ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <Size>40f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>StopButton</ObjectName>
                    <Tooltip>Stopp – bremst wie ein Plattenspieler ab und bleibt an der Stelle stehen. Steht der Titel bereits: zurück zum Anfang</Tooltip>
                    <Size>40f,32f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_stop.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_stop.svg</Pressed></State>
                    <Connection>
                      <ConfigKey>[Skin],twindeck_stop_<Variable name="channum"/></ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <!-- Zurück: mit Helfer erst zum Titelanfang, steht er dort, den vorigen Titel
               der Liste laden; ohne Helfer Links = Titelanfang, Rechts = voriger Titel -->
          <WidgetGroup>
            <Size>34f,32f</Size>
            <Layout>horizontal</Layout>
            <Children>
              <WidgetGroup>
                <Size>34f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>PrevButton</ObjectName>
                    <Tooltip>Zurück – springt zum Titelanfang. Rechtsklick: vorigen Titel der Liste laden (nur bei angehaltenem Player)</Tooltip>
                    <Size>34f,32f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_prev.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_prev.svg</Pressed></State>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,start</ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey>[Playlist],SelectPrevTrack</ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>RightButton</ButtonState>
                    </Connection>
                    <Connection>
                      <ConfigKey><Variable name="group"/>,LoadSelectedTrack</ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>RightButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                  <Transform><Not/></Transform>
                </Connection>
              </WidgetGroup>
              <WidgetGroup>
                <Size>34f,32f</Size>
                <Layout>horizontal</Layout>
                <Children>
                  <PushButton>
                    <ObjectName>PrevButton</ObjectName>
                    <Tooltip>Zurück – springt zum Titelanfang; am Anfang (bzw. in den ersten 3 Sekunden der Wiedergabe) wird der vorige Titel der Liste geladen</Tooltip>
                    <Size>34f,32f</Size>
                    <NumberStates>1</NumberStates>
                    <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_prev.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_prev.svg</Pressed></State>
                    <Connection>
                      <ConfigKey>[Skin],twindeck_prev_<Variable name="channum"/></ConfigKey>
                      <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                      <ButtonState>LeftButton</ButtonState>
                    </Connection>
                  </PushButton>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],twindeck_helper_active</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

          <PushButton>
            <ObjectName>RepeatButton</ObjectName>
            <Tooltip>Repeat – am Titelende wieder von vorn beginnen</Tooltip>
            <Size>38f,32f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_repeat_off.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_repeat_off.svg</Pressed></State>
            <State><Number>1</Number><Unpressed scalemode="STRETCH">skin:graphics/btn_repeat_on.svg</Unpressed><Pressed scalemode="STRETCH">skin:graphics/btn_repeat_on.svg</Pressed></State>
            <Connection>
              <ConfigKey><Variable name="group"/>,repeat</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>4f,1f</Size></WidgetGroup>

          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">SyncButton</SetVariable>
            <SetVariable name="Tooltip">Sync – Tempo und Takt an den anderen Player angleichen</SetVariable>
            <SetVariable name="Size">44f,32f</SetVariable>
            <SetVariable name="Text">SYNC</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,sync_enabled</SetVariable>
          </Template>

          <Template src="skin:btn_push.xml">
            <SetVariable name="ObjectName">DeckButton</SetVariable>
            <SetVariable name="Tooltip">Tap – BPM im Takt mittippen</SetVariable>
            <SetVariable name="Size">40f,32f</SetVariable>
            <SetVariable name="Text">TAP</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,bpm_tap</SetVariable>
          </Template>

          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">DeckToggle</SetVariable>
            <SetVariable name="Tooltip">Master Tempo – Tonhöhe beim Pitchen beibehalten</SetVariable>
            <SetVariable name="Size">42f,32f</SetVariable>
            <SetVariable name="Text">M.T.</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,keylock</SetVariable>
          </Template>

          <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>

          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">PflButton</SetVariable>
            <SetVariable name="Tooltip">Vorhören über Kopfhörer</SetVariable>
            <SetVariable name="Size">52f,32f</SetVariable>
            <SetVariable name="Text">🎧 PFL</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,pfl</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <!-- Cue-Speicher und Loops -->
      <WidgetGroup>
        <ObjectName>CueLoopRow</ObjectName>
        <Size>0me,30f</Size>
        <Layout>horizontal</Layout>
        <Children>
          <Label>
            <ObjectName>RowCaption</ObjectName>
            <Size>34f,24f</Size>
            <Text>CUES</Text>
          </Label>
          <Template src="skin:btn_hotcue.xml"><SetVariable name="hotcue">1</SetVariable></Template>
          <Template src="skin:btn_hotcue.xml"><SetVariable name="hotcue">2</SetVariable></Template>
          <Template src="skin:btn_hotcue.xml"><SetVariable name="hotcue">3</SetVariable></Template>
          <Template src="skin:btn_hotcue.xml"><SetVariable name="hotcue">4</SetVariable></Template>

          <WidgetGroup><SizePolicy>me,f</SizePolicy></WidgetGroup>

          <Label>
            <ObjectName>RowCaption</ObjectName>
            <Size>38f,24f</Size>
            <Text>LOOP</Text>
          </Label>
          <Template src="skin:btn_push.xml">
            <SetVariable name="ObjectName">LoopButton</SetVariable>
            <SetVariable name="Tooltip">Loop-Anfang setzen</SetVariable>
            <SetVariable name="Size">36f,24f</SetVariable>
            <SetVariable name="Text">IN</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,loop_in</SetVariable>
          </Template>
          <Template src="skin:btn_push.xml">
            <SetVariable name="ObjectName">LoopButton</SetVariable>
            <SetVariable name="Tooltip">Loop-Ende setzen</SetVariable>
            <SetVariable name="Size">40f,24f</SetVariable>
            <SetVariable name="Text">OUT</SetVariable>
            <SetVariable name="ConfigKey"><Variable name="group"/>,loop_out</SetVariable>
          </Template>
          <PushButton>
            <ObjectName>LoopButton</ObjectName>
            <TooltipId>beatloop_activate</TooltipId>
            <Size>36f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>4</Text></State>
            <State><Number>1</Number><Text>4</Text></State>
            <Connection>
              <ConfigKey><Variable name="group"/>,beatloop_4_toggle</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="group"/>,beatloop_4_enabled</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>LoopButton</ObjectName>
            <TooltipId>reloop_toggle</TooltipId>
            <Size>46f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>EXIT</Text></State>
            <State><Number>1</Number><Text>EXIT</Text></State>
            <Connection>
              <ConfigKey><Variable name="group"/>,reloop_toggle</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="group"/>,loop_enabled</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
